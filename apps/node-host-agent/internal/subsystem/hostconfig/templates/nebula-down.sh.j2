#!/bin/bash
# Managed by node-config-agent - nebula {{ interdc_nebula_net }}
# post-down (ExecStopPost). Don phan routing cua nebula; KHONG dong
# vao fwmark rules 1390/1400 (shared voi tinc/watchdog).
DEV={{ interdc_nebula_dev }}
ip link set $DEV down 2>/dev/null
nft delete table ip nebnat 2>/dev/null
ip route flush table {{ interdc_nebula_table_pub }} 2>/dev/null
ip route flush table {{ interdc_nebula_table_marker }} 2>/dev/null
ip rule list pref 1500 | sed -n 's/.*to \([0-9./]*\).*/\1/p' | while read -r d; do
  ip rule del pref 1500 to "$d" lookup {{ interdc_nebula_table_pub }} 2>/dev/null
done
ip rule del pref 1490 to {{ interdc_marker_base }}.0/24 lookup {{ interdc_nebula_table_marker }} 2>/dev/null
for p in dport sport; do
  iptables -t mangle -D OUTPUT -p udp --$p {{ interdc_nebula_port }} -j MARK --set-mark 0x1000 2>/dev/null
  iptables -t mangle -D PREROUTING -p udp --$p {{ interdc_nebula_port }} -j MARK --set-mark 0x1000 2>/dev/null
done
exit 0
